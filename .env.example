# RailGaadi Environment Variables
# Copy this file to .env and fill in your API keys

# RailRadar API for real-time Indian Railways telemetry
RAILRADAR_API_KEY=your_railradar_api_key_here

# MapTiler API for vector map tiles
MAPTILER_API_KEY=your_maptiler_api_key_here

# OpenWeather API for live station weather
OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenTopography API for SRTM NASA elevation profiles
OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key_here

# Overpass API for nearby geographic landmarks (optional)
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# Server Port
PORT=4000
NODE_ENV=development
